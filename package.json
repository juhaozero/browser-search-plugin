{
  "name": "browser-search-plugin",
  "version": "0.0.6",
  "description": "Readable single and dual column layouts with automatic pagination for Google and Bing search.",
  "scripts": {
    "test": "node --max-old-space-size=4096 --test --test-isolation=none --test-concurrency=1 \"test/**/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "test:browser": "node --test \"test/browser-*.mjs\"",
    "test:live": "node scripts/verify-live.mjs",
    "lint": "eslint .",
    "sync": "node scripts/sync-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juhaozero/browser-search-plugin.git"
  },
  "keywords": [
    "chrome-extension",
    "google",
    "bing",
    "search",
    "layout",
    "pagination"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/juhaozero/browser-search-plugin/issues"
  },
  "homepage": "https://github.com/juhaozero/browser-search-plugin#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "linkedom": "^0.18.13",
    "puppeteer-core": "25.12.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
